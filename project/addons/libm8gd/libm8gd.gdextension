[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://addons/libm8gd/debug/libm8.so"
linux.release.x86_64 =   "res://addons/libm8gd/release/libm8.so"
windows.debug.x86_64 =   "res://addons/libm8gd/debug/m8.dll"
windows.release.x86_64 = "res://addons/libm8gd/release/m8.dll"
macos.debug =            "res://addons/libm8gd/debug/libm8.dylib"
macos.release =          "res://addons/libm8gd/release/libm8.dylib"
macos.debug.arm64 =      "res://addons/libm8gd/debug/libm8.dylib"
macos.release.arm64 =    "res://addons/libm8gd/release/libm8.dylib"
